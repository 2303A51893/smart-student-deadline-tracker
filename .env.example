# ==============================================================================
# Smart Student Deadline Tracker (DeadlineWise) - Environment Variables
# Copy this file to .env for local development:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# ==============================================================================

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Connection Configuration
# ------------------------------------------------------------------------------
# OPTION A: Full Connection URI (Recommended for Neon, Supabase, Render PostgreSQL)
# Example for Neon: postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deadlinewise

# OPTION B: Discrete Connection Parameters (Used if DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=deadlinewise

# Client Origin for CORS in development (optional, defaults to localhost:5173)
CLIENT_URL=http://localhost:5173
